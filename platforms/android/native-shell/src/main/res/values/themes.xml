<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Views of a surface are created in this theme so Material widgets work in any host theme. -->
    <style name="NativeShell.Theme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Custom-content dialogs: transparent full-screen window; the script draws the card. -->
    <style name="NativeShell.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <!-- Edge-to-edge: the dim scrim covers the system bars instead of M3's tinted bar colors. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Edge-to-edge bottom sheets: the sheet surface runs under the navigation bar;
         the shell pads its content and draws its own grabber and corners. -->
    <style name="NativeShell.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="enableEdgeToEdge">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/NativeShell.BottomSheet.Modal</item>
    </style>

    <style name="NativeShell.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="paddingLeftSystemWindowInsets">false</item>
        <item name="paddingRightSystemWindowInsets">false</item>
        <!-- 16 dp top corners that stay when the sheet is fully expanded. -->
        <item name="shapeAppearance">@style/NativeShell.BottomSheet.Shape</item>
        <item name="shouldRemoveExpandedCorners">false</item>
    </style>

    <style name="NativeShell.BottomSheet.Shape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
